# Copy to ".env" in this folder (backend). Pydantic reads env vars (case-insensitive).

DATABASE_URL=sqlite:///./app.db
JWT_SECRET=dev-secret-change-me

# Where static frontend lives (after OAuth, tokens are saved and browser opens this origin).
FRONTEND_URL=http://127.0.0.1:5500

# Public URL of this API (https, no trailing slash). On Render set to your Web Service URL, e.g.
#   https://your-api.onrender.com
# so OAuth redirect_uri matches Google/Azure (also set the same URI in the provider console).
# Optional locally if you use http://127.0.0.1:8000 — leave empty and the app uses the request URL.
PUBLIC_BASE_URL=

# --- Google OAuth (optional) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs → Web application.
# Authorized redirect URI must match the callback URL exactly, e.g.:
#   http://127.0.0.1:8000/auth/google/callback
#   https://your-api.onrender.com/auth/google/callback
# If you use http://localhost:8000 for the API, add that exact URI too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft OAuth (optional) ---
# Azure Portal → App registrations → your app → Authentication → Web redirect URI:
#   http://127.0.0.1:8000/auth/microsoft/callback
#   https://your-api.onrender.com/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Yandex OAuth (optional) ---
# https://oauth.yandex.ru/ → your app → Redirect URI must match exactly, e.g.:
#   http://127.0.0.1:8000/auth/yandex/callback
#   https://your-api.onrender.com/auth/yandex/callback
# Request rights: login:email, login:info (email + name).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Sales handoff email (optional) ---
# When a user submits a configuration (project name filled), backend emails XLSX to sales inbox.
# For Gmail: create an App Password, use smtp.gmail.com:587, SMTP_USE_TLS=true.
SALES_INBOX_EMAIL=ohibloom@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
