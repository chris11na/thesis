# Copy to ".env" in this folder (backend). Pydantic reads env vars (case-insensitive).

DATABASE_URL=sqlite:///./app.db
JWT_SECRET=dev-secret-change-me

# Where static frontend lives (after OAuth, tokens are saved and browser opens this origin).
FRONTEND_URL=http://127.0.0.1:5500

# --- Google OAuth (optional) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs → Web application.
# Authorized redirect URI must match how you open the API, e.g.:
#   http://127.0.0.1:8000/auth/google/callback
# If you use http://localhost:8000 for the API, add that exact URI too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft OAuth (optional) ---
# Azure Portal → App registrations → your app → Authentication → Web redirect URI:
#   http://127.0.0.1:8000/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
